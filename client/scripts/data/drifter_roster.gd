static func get_palette_for(combatant_id: String, preset_index: int) -> Dictionary:
	if ENEMY_PALETTES.has(combatant_id):
		return ENEMY_PALETTES[combatant_id]
	var preset: Dictionary = PALETTE_PRESETS[preset_index % PALETTE_PRESETS.size()]
	if combatant_id == "drifter_vega":
		return preset["vega"]
	if combatant_id == "drifter_krix":
		return preset["krix"]
	return preset["syl"]


static func get_preset_name(preset_index: int) -> String:
	return String(PALETTE_PRESETS[preset_index % PALETTE_PRESETS.size()]["name"])


